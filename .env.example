# Copy this file to .env.local for your computer, and add the same values in Vercel.

# Supabase > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
# The service role key is a master key. Keep it secret. Never put it in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# The password you and your family use at /admin. Use at least 12 characters.
ADMIN_PASSWORD=

# Any long random text. It protects the admin login cookie and anonymises IP addresses used for spam limits.
APP_SECRET=
